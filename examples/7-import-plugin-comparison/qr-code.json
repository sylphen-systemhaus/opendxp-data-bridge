            "calculation": "\/\/ please enable \"Overwrite images\" option above, otherwise every import run will create a new image \n$url = {{ QR Code QR-Code Text }};\n\n$qrCode = new \\Endroid\\QrCode\\QrCode($url ?? '');\n$filename = \\PIMCORE_SYSTEM_TEMP_DIRECTORY.'\/import_10_qrCode_'.\\uniqid(\\OpenDxp\\File::getValidFilename($url), true).'.svg';\n\n$writer = new \\Endroid\\QrCode\\Writer\\SvgWriter();\nif(method_exists($writer, 'write')) {\n    \/\/ endroid\/qr-code version 4\n    $writer->write($qrCode)->saveToFile($filename);\n} else {\n    \/\/ endroid\/qr-code version 3\n    $qrCode->setWriter($writer);\n    $qrCode->writeFile($filename);\n}\n\n$qrCodeFilename = {{ QR Code QR-Code Filename }};\nif(substr($qrCodeFilename, -4) !== '.svg') {\n    $qrCodeFilename .= '.svg';\n}\nreturn [\n  'url' => $filename,\n  'filename' => 'qrCode\/'.\\OpenDxp\\File::getValidFilename($qrCodeFilename),\n];",
