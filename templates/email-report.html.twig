<html lang="en">
<head>
    <title>Data Bridge Log Report</title>
    <meta charset="utf-8">
    <style type="text/css">
        body {
            font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
            font-size: 14px;
        }

        .reportTable {
            border: 1px solid #000;
            border-collapse: collapse;
        }

        .reportTable th {
            text-align: left;
        }

        .reportTable td, .reportTable th {
            border: 1px solid #000;
            padding: 5px 10px;
        }

        .reportTable td {
            vertical-align: top;
        }
    </style>
</head>
<body>

<p>There were errors when executing dataport "{{ dataport['name'] }}" (Id {{ dataport['id'] }}):</p>
<table class="reportTable">
    <tr>
        <th>Log level</th>
        <th>Related object</th>
        <th>Message</th>
    </tr>
    {% for log in logs %}
        <tr>
            <td>{{ log.level }}</td>
            <td>{{ log.relatedObject|raw }}</td>
            <td>
                {{ log.message|nl2br }}
                {% if log.count > 1 %}
                    <br><br>This or similar errors happened {{ log.count }} times. Please see <a href="{{ fileObjectUrl }}">process log of this run</a> to get further details.
                {% endif %}
            </td>
        </tr>
    {% endfor %}
</table>

{% if fileObjectUrl != "" %}
    <p>These are only error logs. To get the context of what got imported incl. non-error logs, please see the <a href="{{ fileObjectUrl }}">process log of this run</a>.</p>
{% endif %}
</body>
</html>